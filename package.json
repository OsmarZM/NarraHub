{
  "name": "narrahub-app",
  "version": "0.3.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-desktop.ps1 -Mode dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-desktop.ps1 -Mode build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:apk": "tauri android build --debug --apk --target aarch64 --ci",
    "android:release:apk": "tauri android build --apk --target aarch64 --ci",
    "share-api:dev": "node services/share-api/src/server.mjs",
    "share-api:test": "node --test services/share-api/test/*.test.mjs",
    "release:prepare-config": "node scripts/prepare-release-config.mjs",
    "release:validate-updater": "node scripts/validate-updater-environment.mjs",
    "release:validate-version": "node scripts/validate-release-version.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-mention": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "cytoscape": "^3.34.1",
    "ngx-tiptap": "^14.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
